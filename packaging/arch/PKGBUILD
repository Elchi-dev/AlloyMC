# Maintainer: Elchi <samuel@elchi.dev>
# Native Arch package for Alloy, built from the repository against the system WebKitGTK.
#
#   cd packaging/arch && makepkg -si
#
# Builds from the local checkout (two levels up), so it works for a private repo.

pkgname=alloy-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Alloy, the Minecraft launcher"
arch=('x86_64')
url="https://github.com/Elchi-dev/alloy"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
optdepends=('gnome-keyring: store sign-ins in the system keychain'
            'kwallet: store sign-ins in the system keychain (KDE)')
makedepends=('rust' 'cargo' 'nodejs' 'pnpm')
install=alloy.install
options=('!lto')

_root="$(realpath ../..)"

build() {
  cd "$_root"
  pnpm install --frozen-lockfile
  pnpm tauri build --no-bundle
}

package() {
  cd "$_root"
  install -Dm755 target/release/alloy "$pkgdir/usr/bin/alloy"
  install -Dm644 packaging/arch/alloy.desktop "$pkgdir/usr/share/applications/alloy.desktop"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/alloy.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/alloy.png"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/alloy.png"

  # Block textures, fetched from Mojang at install time (not bundled with Alloy).
  ./target/release/alloy --fetch-assets "$pkgdir/usr/share/alloy/textures" \
    || echo "Could not fetch textures now; Alloy fetches them on first start."
}
